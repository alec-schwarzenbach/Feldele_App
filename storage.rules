rules_version = '2';

// Photos (catches, board posts): approved members can see them,
// everyone uploads only into their own folder. Yearly bills: owner and admins.
service firebase.storage {
  match /b/{bucket}/o {
    function approved() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role != 'pending';
    }

    match /photos/{uid}/{file} {
      allow read: if approved();
      allow create: if approved() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Yearly bills (Excel): only the owner and admins.
    match /reports/{file} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
  }
}
