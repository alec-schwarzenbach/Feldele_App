# Copy to .env.local and fill in from Firebase console →
# Project settings → General → Your apps → Web app → "SDK setup and configuration" → Config.
# Leave empty to run in demo mode (data stored only in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=feldele.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=feldele
VITE_FIREBASE_STORAGE_BUCKET=feldele.firebasestorage.app
VITE_FIREBASE_APP_ID=
