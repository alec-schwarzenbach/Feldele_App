rules_version = '2';

// Who may read and write what. Deploy with:  npx firebase-tools deploy --only firestore:rules,storage
//  - owner:      everything; the only one who can change roles (set the owner once in the Firebase console)
//  - admin:      everything except roles; the only ones who see costs
//  - member:     stays, car, fishing, board
//  - car_keeper: same as member; receives the car notifications
//  - pending:    new sign-up, can only read their own profile until approved
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function me() { return get(profilePath(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(profilePath(request.auth.uid)); }
    function approved() { return hasProfile() && me().role != 'pending'; }
    function admin() { return hasProfile() && me().role in ['owner', 'admin']; }
    function owner() { return hasProfile() && me().role == 'owner'; }

    function mine() { return resource.data.userId == request.auth.uid; }
    function createsMine() { return request.resource.data.userId == request.auth.uid; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── Profiles ──
    match /profiles/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      // Everyone signs up as 'pending'.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if
        // your own name / family
        (approved() && request.auth.uid == uid && changes().hasOnly(['name', 'family']))
        // admins can fix names
        || (admin() && changes().hasOnly(['name', 'family']))
        // only the owner hands out roles, and never the owner role itself
        || (owner() && uid != request.auth.uid && resource.data.role != 'owner'
            && request.resource.data.role in ['pending', 'member', 'admin', 'car_keeper']
            && changes().hasOnly(['role']));
    }

    // ── Settings & rooms: everyone reads, admins edit; only the owner sets the priority order ──
    match /settings/{id} {
      allow read: if approved();
      allow create: if owner();
      allow update: if owner()
        || (admin() && !changes().hasAny(['priorityOrder', 'priorityStartYear']));
    }
    match /rooms/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // ── Costs: admins only ──
    match /costs/{id} {
      allow read, write: if admin();
    }

    // ── Reservations ──
    function validStay(d) {
      return d.start is string && d.end is string && d.end > d.start
        && d.people is int && d.people > 0 && d.roomIds is list;
    }
    // Does the signed-in user have priority in the year this stay starts?
    // Same rotation as the app: priorityOrder[0] in priorityStartYear, then the next, repeating.
    function hasPriority(start) {
      let s = get(/databases/$(database)/documents/settings/main).data;
      let order = s.get('priorityOrder', []);
      let n = order.size();
      let offset = int(start.split('-')[0]) - s.get('priorityStartYear', 0);
      return n > 0 && order[((offset % n) + n) % n] == request.auth.uid;
    }
    // Today as YYYY-MM-DD (UTC), to compare with day strings.
    function todayDay() {
      let m = request.time.month();
      let d = request.time.day();
      return string(request.time.year()) + '-' + (m < 10 ? '0' : '') + string(m) + '-' + (d < 10 ? '0' : '') + string(d);
    }
    // A priority booking can only be cancelled for free during its 4 weeks.
    function claimExpired(r) {
      return r.get('priorityClaim', false) == true && todayDay() > r.get('claimDeadline', '9999-12-31');
    }
    // Fields only the system flow (bump / confirm / cancel) may change.
    function protectedFields() {
      return ['status', 'lateCancel', 'cancelledAt', 'createdAt', 'priorityClaim', 'claimDeadline', 'bumpedBy', 'userId'];
    }

    match /reservations/{id} {
      allow read: if approved();
      allow create: if approved() && createsMine() && validStay(request.resource.data)
        && request.resource.data.status in ['active', 'tentative']
        // only the year's priority user can take over other people's dates
        && (request.resource.data.get('priorityClaim', false) == false || hasPriority(request.resource.data.start));
      allow update: if admin()
        // edit your own open stay (dates, people, rooms, notes)
        || (approved() && mine() && resource.data.status != 'cancelled'
            && validStay(request.resource.data) && !changes().hasAny(protectedFields()))
        // cancel your own stay; a priority booking past its 4 weeks must be billed
        || (approved() && mine() && resource.data.status != 'cancelled'
            && request.resource.data.status == 'cancelled'
            && changes().hasOnly(['status', 'lateCancel', 'cancelledAt'])
            && (request.resource.data.lateCancel == true || !claimExpired(resource.data)))
        // the priority user moves someone else's stay to "maybe"
        || (approved() && !mine() && resource.data.status == 'active'
            && request.resource.data.status == 'tentative'
            && changes().hasOnly(['status', 'bumpedBy']) && hasPriority(resource.data.start))
        // a "maybe" stay becomes confirmed when the blocking stay is cancelled
        || (approved() && resource.data.status == 'tentative'
            && request.resource.data.status == 'active'
            && changes().hasOnly(['status', 'bumpedBy']));
      allow delete: if admin();
    }

    // ── Car ──
    match /carBookings/{id} {
      allow read: if approved();
      allow create: if approved() && createsMine()
        && request.resource.data.start is string && request.resource.data.end >= request.resource.data.start;
      allow delete: if admin() || (approved() && mine());
    }

    // Car notifications go only to the car owner (Günter). Stay notifications
    // tell a member that their stay became "maybe" or confirmed.
    // Only the recipient can read them.
    match /notifications/{id} {
      allow read, delete: if signedIn() && mine();
      allow create: if approved() && request.resource.data.read == false && (
        (request.resource.data.kind == 'car'
          && get(profilePath(request.resource.data.userId)).data.role == 'car_keeper')
        || (request.resource.data.kind == 'stay'
          && exists(profilePath(request.resource.data.userId))));
      allow update: if signedIn() && mine() && changes().hasOnly(['read']);
    }

    // ── Fishing & board: everyone reads, authors (and admins) edit ──
    match /catches/{id} {
      allow read: if approved();
      allow create: if approved() && createsMine()
        && request.resource.data.reason in ['starving', 'injured'];
      allow update, delete: if admin() || (approved() && mine() && (request.resource == null || createsMine()));
    }
    match /posts/{id} {
      allow read: if approved();
      allow create: if approved() && createsMine();
      allow update, delete: if admin() || (approved() && mine() && (request.resource == null || createsMine()));
    }
    match /comments/{id} {
      allow read: if approved();
      allow create: if approved() && createsMine();
      allow update, delete: if admin() || (approved() && mine() && (request.resource == null || createsMine()));
    }
  }
}
